{
  "cmake.sourceDirectory": "${workspaceFolder}/native",
  "cmake.buildDirectory": "${workspaceFolder}/native/build",
  "cmake.configureSettings": { "PARROT_ENGINE": "ON" },
  "C_Cpp.default.cppStandard": "c++17",
  "python.defaultInterpreterPath": "${workspaceFolder}/ml/.venv/Scripts/python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "${workspaceFolder}/ml",
  "python.testing.pytestArgs": ["tests"],
  "dart.flutterSdkPath": "C:\flutter",
  "dart.projectSearchDepth": 2,
  "files.exclude": { "native/build*": true, "app/build": true, "app/.dart_tool": true, "**/__pycache__": true },
  "search.exclude": { "native/third_party": true, "native/build*": true, "app/build": true, "ml/data": true, "ml/work": true, "ml/.venv": true }
}
